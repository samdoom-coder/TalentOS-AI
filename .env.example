# --- Database ---
# Local dev uses SQLite (zero-dependency). For production switch to Postgres:
#   1. Set DATABASE_PROVIDER=postgresql
#   2. Point DATABASE_URL to Postgres and use prisma/schema.postgres.prisma
#   3. Set REDIS_URL to a real Redis (local dev uses in-process queue)
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
REDIS_URL=""

# --- Auth ---
AUTH_SECRET="dev-secret-change-me-min-32-chars-long!!"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI (all optional in dev; MockProvider is used when keys are absent) ---
AI_PROVIDER="mock"
AI_DEFAULT_MODEL="mock-v1"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Storage (local filesystem by default; S3/R2/GCS-ready interface) ---
STORAGE_PROVIDER="local"
STORAGE_DIR="./uploads"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="auto"

# --- Email (console/log provider by default) ---
EMAIL_PROVIDER="console"
EMAIL_API_KEY=
EMAIL_FROM="TalentOS AI <noreply@talentos.ai>"

# --- Billing (disabled by default; Stripe-ready abstraction) ---
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=

# --- Feature flags (comma overrides or individual envs) ---
FEATURE_AI_INTERVIEW="true"
FEATURE_VOICE_INTERVIEW="false"
FEATURE_CODING_ASSESSMENT="true"
FEATURE_ROLEPLAY="true"
FEATURE_SHOWCASE="true"
FEATURE_SEMANTIC_SEARCH="false"
FEATURE_BILLING="false"
FEATURE_WHATSAPP="false"
