# --- Database ---
# Local dev uses SQLite (zero-dependency). For production switch to Postgres:
#   1. Set DATABASE_PROVIDER=postgresql
#   2. Point DATABASE_URL to Postgres and use prisma/schema.postgres.prisma
#   3. Set REDIS_URL to a real Redis (local dev uses in-process queue)
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
REDIS_URL=""

# --- Auth ---
# REQUIRED in production: random 32+ chars (e.g. `openssl rand -hex 32`).
# App refuses to boot in production when missing/short. Dev fallback only.
AUTH_SECRET="dev-secret-change-me-min-32-chars-long!!"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI (all optional in dev; MockProvider is used when keys are absent) ---
# Scoring paths fail closed on provider error (no silent mock scores).
# Opt-in mock fallback per-call only: runAi({ allowFallback: true }).
AI_PROVIDER="mock"
AI_DEFAULT_MODEL="mock-v1"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Code execution: vm-dev (local only) | judge0 (production isolated workers)
EXECUTION_PROVIDER="vm-dev"

# --- Storage (local filesystem by default; S3/R2/GCS-ready interface) ---
STORAGE_PROVIDER="local"
STORAGE_DIR="./uploads"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION="auto"

# --- Email (console/log provider by default) ---
# Prod: EMAIL_PROVIDER=resend|sendgrid + EMAIL_API_KEY, or generic EMAIL_WEBHOOK_URL.
EMAIL_PROVIDER="console"
EMAIL_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_FROM="TalentOS AI <noreply@talentos.ai>"

# --- Billing (disabled by default; Stripe-ready abstraction) ---
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=

# --- Feature flags (comma overrides or individual envs) ---
FEATURE_AI_INTERVIEW="true"
FEATURE_VOICE_INTERVIEW="false"
FEATURE_CODING_ASSESSMENT="true"
FEATURE_ROLEPLAY="true"
FEATURE_SHOWCASE="true"
FEATURE_SEMANTIC_SEARCH="false"
FEATURE_BILLING="false"
FEATURE_WHATSAPP="false"

# --- Execution / voice / search (all optional; offline fallbacks) ---
# Judge0 isolated code exec: JUDGE0_URL + EXECUTION_PROVIDER=judge0
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_HOST=
# Voice: OPENAI_API_KEY enables Whisper+TTS; DEEPGRAM_API_KEY STT; ELEVENLABS_API_KEY TTS
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_EMBED_MODEL="text-embedding-3-small"
# Calendar/Meet OAuth (optional; flows degrade to local slots)
GOOGLE_CLIENT_ID=
MS_CLIENT_ID=
ZOOM_CLIENT_ID=
# SSO (Phase 5 stub; local auth always works)
LINKEDIN_CLIENT_ID=
# Observability
LOG_LEVEL="info"
SENTRY_DSN=
ALLOW_LOCAL_WEBHOOKS=
